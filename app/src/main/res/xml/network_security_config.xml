<?xml version="1.0" encoding="utf-8"?>
<!--
  Radio: many stations stream over plain http and the user picks them from their own
  .m3u files, so a per-domain list cannot work. The PC remote does not depend on this:
  it is TLS with a pinned certificate.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
